# =============================================================
# Financial Intelligence & Stock Analytics Platform
# Environment Variables Template
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# MongoDB connection URI & database (Phase 3)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=financial_analytics

# LLM API key (OpenAI, Google AI, or compatible provider)
LLM_API_KEY=your_api_key_here

# Vector database storage path
VECTOR_DB_PATH=./vector_db

# Optional: Hadoop/HDFS namenode URI (Phase 2)
# HDFS_NAMENODE=hdfs://localhost:9000
